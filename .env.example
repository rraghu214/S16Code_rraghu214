# S16Code contains no provider keys. Provider credentials belong to the gateway.
GLC_BASE_URL=http://127.0.0.1:8111
S16_GATEWAY_PROVIDER=gemini
S16_PORT=8113
S16_A2A_GRPC_PORT=8114
S16_CHUNK_MODEL=phi4:latest
S16_LIVE_SEMANTIC_CHUNKING=1
S16_MAX_WORKERS=4

# GLC v5 channel bridge. Use the same private value as GLC_S16_BRIDGE_TOKEN.
S16_CHANNEL_BRIDGE_TOKEN=replace-with-a-long-random-local-token
S16_CHANNEL_TENANT=local
# Explicit comma-separated authority for channel-originated side effects.
# Empty is read-only. Enable only what paired owners should be allowed to ask for.
# The complete shipped set is shown so the policy is visible, not hidden in code.
S16_CHANNEL_ALLOWED_SIDE_EFFECTS=remember_explicit_fact,write_file,copy_file,index_file,create_calendar_events,send_channel_message,launch_job,request_approval

# Set this to an absolute path before using local file skills.
S16_SANDBOX_ROOT=/absolute/path/to/S16Code/sandbox

# Economics config directory. Defaults to ./config beside the package.
# S16_CONFIG_DIR=/absolute/path/to/S16Code/config

# Trace export. Unset means the span tree is still built and asserted in memory
# and nothing goes over the wire, so tests and CI need no collector.
# S16_OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318/v1/traces
# S16_OTEL_SERVICE_NAME=s16code
# Prompts and completions are PII. Content capture stays OFF unless set to 1.
S16_OTEL_CAPTURE_CONTENT=0
